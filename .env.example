# Copy to .env and fill in. .env is gitignored.

# Required for cloud layers and the eval harness.
OPENROUTER_API_KEY=

# Gateway (M4+). Unused before then.
NODREL_TOKEN=
NODREL_GATEWAY_URL=https://api.nodrel.dev

# Local model runtime. Optional.
OLLAMA_HOST=http://localhost:11434

# Telemetry: off | local | aggregate
NODREL_TELEMETRY=local
